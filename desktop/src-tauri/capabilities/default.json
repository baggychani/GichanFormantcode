{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main and interactive plot windows",
  "windows": ["main", "single-plot"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/gichan-formant-sidecar",
          "sidecar": true,
          "args": ["--desktop"]
        }
      ]
    }
  ]
}
